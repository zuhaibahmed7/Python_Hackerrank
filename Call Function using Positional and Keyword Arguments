def describe_pet(animal_type, pet_name):
  print(f"I have a {animal_type}")
  print(f"My {animal_type}'s name is {pet_name}")

describe_pet("Bird", "Mitthu")    # positional calling
describe_pet(animal_type = "Bird", pet_name = "Mitthu") # Keyword calling

describe_pet(pet_name = "Mitthu" , animal_type = "Bird")
