def Print_pyramid_pattern(rows):
    # Increasing part
    for i in range(1, rows + 1):
        for j in range(i):
            print("*", end=" ")
        print()

    # Decreasing part
    for i in range(rows - 1, 0, -1):
        for j in range(i):
            print("*", end=" ")
        print()


Print_pyramid_pattern(5)
